  "item": [
    {
      "name": "ms-usuarios (8081) — Autenticación y Usuarios",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{MS_USUARIOS_URL}}/auth/register", "host": ["{{MS_USUARIOS_URL}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"email\": \"juan@notara.cl\",\n  \"password\": \"Clave1234!\"\n}"
            }
          },
          "response": [
            {
              "name": "201 - Usuario registrado",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiJ9...\",\n  \"refreshToken\": \"eyJhbGciOiJIUzI1NiJ9...\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('ACCESS_TOKEN', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{MS_USUARIOS_URL}}/auth/login", "host": ["{{MS_USUARIOS_URL}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@notara.cl\",\n  \"password\": \"Clave1234!\"\n}"
            }
          },
          "response": [
            {
              "name": "200 - Login exitoso",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiJ9...\",\n  \"refreshToken\": \"eyJhbGciOiJIUzI1NiJ9...\"\n}"
            },
            {
              "name": "401 - Credenciales inválidas",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"error\": \"Credenciales inválidas\"\n}"
            }
          ]
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": { "raw": "{{MS_USUARIOS_URL}}/usuarios/1", "host": ["{{MS_USUARIOS_URL}}"], "path": ["usuarios", "1"] }
          },
          "response": [
            {
              "name": "200 - Usuario encontrado",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": 1,\n  \"nombre\": \"Juan Pérez\",\n  \"email\": \"juan@notara.cl\"\n}"
            }
          ]
        },
        {
          "name": "Listar todos los usuarios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": { "raw": "{{MS_USUARIOS_URL}}/usuarios", "host": ["{{MS_USUARIOS_URL}}"], "path": ["usuarios"] }
          }
        },
        {
          "name": "Obtener progreso de usuario",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": { "raw": "{{MS_USUARIOS_URL}}/progress/1", "host": ["{{MS_USUARIOS_URL}}"], "path": ["progress", "1"] }
          }
        },
        {
          "name": "Guardar progreso de usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{MS_USUARIOS_URL}}/progress/1", "host": ["{{MS_USUARIOS_URL}}"], "path": ["progress", "1"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leccionCompletada\": \"intro-musica\",\n  \"puntaje\": 85\n}"
            }
          }
        }
      ]
